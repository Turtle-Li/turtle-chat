+def _standalone_reference_images(*values: Any) -> list[dict[str, str]]:
+    images: list[dict[str, str]] = []
+    seen: set[str] = set()
+
+    def add(value: Any, depth: int = 0, query: str = "") -> None:
+        if len(images) >= MAX_TURTLE_REFERENCE_IMAGES or depth > 3:
+            return
+        if isinstance(value, list):
+            for entry in value:
+                add(entry, depth + 1, query)
+            return
+        if not isinstance(value, dict):
+            return
+        nested_query = _bounded_reference_text(
+            value.get("image_search_query"),
+            240,
+        ) or query
+        result = value.get("image_result")
+        if not isinstance(result, dict):
+            result = value
+        image_url = _safe_reference_url(
+            _reference_value(
+                result,
+                "content_url",
+                "image_url",
+                "thumbnail_url",
+            )
+        )
+        if image_url and image_url not in seen:
+            seen.add(image_url)
+            image = {
+                "image_url": image_url,
+                "title": _bounded_reference_text(
+                    _reference_value(result, "title", "name", "alt"),
+                    240,
+                ),
+                "source_url": _safe_reference_url(
+                    _reference_value(result, "source_url", "page_url", "url")
+                ),
+                "source_name": _bounded_reference_text(
+                    _reference_value(result, "source_name", "site_name", "domain"),
+                    120,
+                ),
+            }
+            if nested_query:
+                image["query"] = nested_query
+            images.append(image)
+        for field in (
+            "image",
+            "image_result",
+            "images",
+            "optimistic_image_results",
+            "results",
+        ):
+            nested = value.get(field)
+            if isinstance(nested, (dict, list)) and nested is not result:
+                add(nested, depth + 1, nested_query)
+
+    for value in values:
+        add(value)
+    return images
+
