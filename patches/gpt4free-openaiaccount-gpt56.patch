+    @classmethod
+    async def cleanup_turtle_resource(
+        cls,
+        resource_type: str,
+        resource_id: str,
+        *,
+        dry_run: bool = True,
+        conversation_action: str = "delete",
+    ) -> dict:
+        """Delete one exact resource previously observed in a Turtle response.
+
+        This intentionally has no list operation. The caller must supply the
+        opaque ID it recorded when Turtle created the resource, preventing a
+        cleanup job from sweeping unrelated account content.
+        """
+
+        if conversation_action not in {"archive", "delete"}:
+            raise ValueError("unsupported Turtle conversation cleanup action")
+        if dry_run:
+            return {"ok": True, "dry_run": True, "http_status": None}
+        auth_result = cls.get_auth_result()
+        if cls._headers is None and getattr(auth_result, "cookies", None):
+            cls._create_request_args(auth_result.cookies, auth_result.headers)
+        if not cls._set_api_key(getattr(auth_result, "api_key", None)):
+            raise MissingAuthError("Access token is not valid")
+        if resource_type == "conversation":
+            url = f"{cls.url}/backend-api/conversation/{resource_id}"
+            method = "PATCH"
+            json_data = (
+                {"is_archived": True}
+                if conversation_action == "archive"
+                else {"is_visible": False}
+            )
+        elif resource_type in {"input_file", "generated_asset"}:
+            url = f"{cls.url}/backend-api/files/{resource_id}"
+            method = "DELETE"
+            json_data = None
+        else:
+            raise ValueError("unsupported Turtle cleanup resource type")
+
+        async with StreamSession(
+            impersonate="chrome",
+            timeout=60,
+        ) as session:
+            request = (
+                session.patch(url, json=json_data, headers=cls._headers)
+                if method == "PATCH"
+                else session.delete(url, headers=cls._headers)
+            )
+            async with request as response:
+                cls._update_request_args(auth_result, session)
+                if response.status in {401, 403}:
+                    raise MissingAuthError("Access token is not valid")
+                if response.status == 429:
+                    raise RateLimitError("ChatGPT account rate limit reached")
+                if response.status == 404:
+                    return {
+                        "ok": True,
+                        "dry_run": False,
+                        "http_status": 404,
+                    }
+                if response.status >= 400:
+                    debug.error(
+                        f"OpenaiChat: Turtle cleanup failed with HTTP {response.status}"
+                    )
+                await raise_for_status(response)
+                return {
+                    "ok": True,
+                    "dry_run": False,
+                    "http_status": int(response.status),
+                }
