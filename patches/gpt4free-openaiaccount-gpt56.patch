+def _elapsed_ms(started: float) -> int:
+    return max(0, int((time.monotonic() - started) * 1000))
+
+
+def _retry_after_candidate(value: Any, *, key: str = "") -> int | None:
+    now = time.time()
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        numeric = float(value)
+        if key.endswith("_ms"):
+            numeric /= 1000
+        elif numeric >= 10**12:
+            numeric = numeric / 1000 - now
+        elif numeric >= now - 60:
+            numeric -= now
+        if numeric <= 0:
+            return None
+        return min(24 * 60 * 60, max(1, int(numeric)))
+    if not isinstance(value, str):
+        return None
+    normalized = value.strip()
+    if not normalized:
+        return None
+    try:
+        return _retry_after_candidate(float(normalized), key=key)
+    except ValueError:
+        pass
+    try:
+        parsed = parsedate_to_datetime(normalized)
+    except (TypeError, ValueError, OverflowError):
+        try:
+            parsed = datetime.fromisoformat(normalized.replace("Z", "+00:00"))
+        except (TypeError, ValueError, OverflowError):
+            return None
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=timezone.utc)
+    seconds = int(parsed.timestamp() - now)
+    return min(24 * 60 * 60, max(1, seconds)) if seconds > 0 else None
+
+
+def _retry_after_from_payload(value: Any) -> int | None:
+    allowed = {
+        "retry_after",
+        "retry_after_s",
+        "retry_after_seconds",
+        "retry_after_ms",
+        "reset_after",
+        "reset_after_s",
+        "reset_after_seconds",
+        "reset_after_ms",
+        "reset_at",
+        "resets_at",
+        "reset_time",
+        "next_reset_at",
+        "available_at",
+    }
+    if isinstance(value, list):
+        for item in value[:20]:
+            candidate = _retry_after_from_payload(item)
+            if candidate is not None:
+                return candidate
+        return None
+    if not isinstance(value, dict):
+        return None
+    for raw_key, item in list(value.items())[:40]:
+        key = str(raw_key).strip().casefold().replace("-", "_")
+        if key in allowed:
+            candidate = _retry_after_candidate(item, key=key)
+            if candidate is not None:
+                return candidate
+    for item in list(value.values())[:40]:
+        candidate = _retry_after_from_payload(item)
+        if candidate is not None:
+            return candidate
+    return None
+
+
+async def _rate_limit_error(response: Any) -> RateLimitError:
+    retry_after = None
+    headers = getattr(response, "headers", None)
+    if headers is not None:
+        for key in (
+            "retry-after",
+            "x-ratelimit-reset",
+            "x-ratelimit-reset-requests",
+        ):
+            candidate = _retry_after_candidate(headers.get(key), key=key.replace("-", "_"))
+            if candidate is not None:
+                retry_after = candidate
+                break
+    if retry_after is None:
+        try:
+            retry_after = _retry_after_from_payload(await response.json())
+        except Exception:
+            retry_after = None
+    suffix = f"; turtle_retry_after_s={retry_after}" if retry_after is not None else ""
+    return RateLimitError(f"ChatGPT account rate limit reached{suffix}")
+
+
+def _media_upload_concurrency() -> int:
+    try:
+        concurrency = int(os.getenv("TURTLE_MEDIA_UPLOAD_CONCURRENCY", "3"))
+    except ValueError as exc:
+        raise MediaPumpError("media upload concurrency configuration is invalid") from exc
+    if concurrency < 1 or concurrency > 4:
+        raise MediaPumpError("media upload concurrency configuration is invalid")
+    return concurrency
