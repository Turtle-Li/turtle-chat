+def _product_reference_items(*values: Any) -> list[dict[str, str]]:
+    products: list[dict[str, str]] = []
+    seen: set[tuple[str, str]] = set()
+    for value in values:
+        for item in _product_items(value) + _reference_collection_items(value):
+            name = _bounded_reference_text(item.get("name"), 180)
+            if not name:
+                continue
+            tag = _bounded_reference_text(
+                item.get("tag") or item.get("subtitle"),
+                160,
+            )
+            url = _safe_reference_url(item.get("url"))
+            key = (name.casefold(), url)
+            if key in seen:
+                continue
+            seen.add(key)
+            products.append({"name": name, "tag": tag, "url": url})
+            if len(products) >= 10:
+                return products
+    return products
