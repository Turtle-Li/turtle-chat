+def _render_turtle_content_reference(
+    sequence_content: str,
+    references: "ContentReferences",
+) -> str | None:
+    reference_type, payload = _content_reference_payload(sequence_content)
+    if (
+        not reference_type
+        or reference_type.startswith("turn")
+    ):
+        return None
+    if reference_type in PASSTHROUGH_CONTENT_REFERENCE_TYPES and payload is None:
+        return None
+    if reference_type in IMAGE_CONTENT_REFERENCE_TYPES:
+        return _render_image_reference(reference_type, payload, references)
+    if reference_type in PRODUCT_CONTENT_REFERENCE_TYPES:
+        return _render_product_reference(reference_type, payload, references)
+    if reference_type in ENTITY_CONTENT_REFERENCE_TYPES:
+        return _render_entity_component(reference_type, payload, references)
+    if reference_type == "url":
+        rendered_url = _render_url_reference(payload)
+        if rendered_url:
+            return rendered_url
+        return _render_reference_collection(reference_type, payload, references)
+    if reference_type in COLLECTION_CONTENT_REFERENCE_TYPES:
+        return _render_reference_collection(reference_type, payload, references)
+    if reference_type in SILENT_CONTENT_REFERENCE_TYPES:
+        return _reference_fallback_text(reference_type, references, payload)
+    if reference_type in CURRENT_CONTENT_REFERENCE_TYPES:
+        return _reference_fallback_text(reference_type, references, payload)
+    if not re.fullmatch(r"[a-z][a-z0-9_:-]{0,63}", reference_type):
+        return ""
+    debug.log(f"OpenaiChat: Unsupported rich content reference: {reference_type}")
+    return _reference_fallback_text(reference_type, references, payload)
