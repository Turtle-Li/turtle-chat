+def _reference_collection_items(*values: Any) -> list[dict[str, str]]:
+    items: list[dict[str, str]] = []
+    seen: set[tuple[str, str]] = set()
+
+    def add(value: Any, depth: int = 0) -> None:
+        if len(items) >= 12 or depth > 3:
+            return
+        if isinstance(value, list):
+            for entry in value:
+                add(entry, depth + 1)
+            return
+        if not isinstance(value, dict):
+            return
+        item = _reference_item(value)
+        if item:
+            key = (item["name"].casefold(), item["url"])
+            if key not in seen:
+                seen.add(key)
+                items.append(item)
+        for field in (
+            "businesses",
+            "entries",
+            "fallback_items",
+            "files",
+            "items",
+            "places",
+            "products",
+            "results",
+            "sources",
+            "webpages",
+        ):
+            nested = value.get(field)
+            if isinstance(nested, (dict, list)):
+                add(nested, depth + 1)
+
+    for value in values:
+        add(value)
+    return items
+
