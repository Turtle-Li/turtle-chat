+def _render_entity_component(
+    reference_type: str,
+    payload: Any,
+    references: "ContentReferences",
+) -> str:
+    if reference_type == "entity":
+        return _render_entity_reference(payload)
+    reference = _select_content_reference(reference_type, payload, references)
+    items = _reference_collection_items(payload, reference)
+    if len(items) > 1 or reference_type in {"businesses_map", "map"}:
+        return _render_reference_collection(reference_type, payload, references)
+    candidate = payload
+    if isinstance(reference, dict):
+        candidate = reference.get("entity") or reference.get("entity_data") or reference
+    entity = _entity_from_payload(candidate)
+    if not entity.get("name") and items:
+        item = items[0]
+        entity = {
+            "entity_type": reference_type,
+            "name": item["name"],
+            "description": item["subtitle"],
+            "url": item["url"],
+        }
+    if entity.get("name"):
+        return _turtle_reference_link("entity", entity["name"], entity)
+    return _reference_fallback_text(reference_type, references, payload)
