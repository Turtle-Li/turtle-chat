+            ):
+                yield encoded_item
+            for nested in value.values():
+                yield from cls.iter_handoff_items(nested, expected_topic, current_topic)
+        elif isinstance(value, list):
+            for nested in value:
+                yield from cls.iter_handoff_items(nested, expected_topic, current_topic)
