+def _entity_from_payload(payload: Any) -> dict[str, str]:
+    if isinstance(payload, dict):
+        return {
+            "entity_type": _bounded_reference_text(
+                _reference_value(payload, "type", "entity_type"),
+                80,
+            ),
+            "name": _bounded_reference_text(
+                _reference_value(payload, "name", "title", "label"),
+                180,
+            ),
+            "description": _bounded_reference_text(
+                _reference_value(
+                    payload,
+                    "disambiguation",
+                    "description",
+                    "subtitle",
+                    "location",
+                ),
+                240,
+            ),
+            "url": _safe_reference_url(
+                _reference_value(payload, "url", "link", "source_url")
+            ),
+        }
+    if isinstance(payload, list):
+        values = [_bounded_reference_text(value, 240) for value in payload[:3]]
+        values.extend([""] * (3 - len(values)))
+        return {
+            "entity_type": values[0],
+            "name": values[1],
+            "description": values[2],
+            "url": "",
+        }
+    return {
+        "entity_type": "",
+        "name": _bounded_reference_text(payload, 180),
+        "description": "",
+        "url": "",
+    }
+
+
+def _render_entity_reference(payload: Any, kind: str = "entity") -> str:
+    entity = _entity_from_payload(payload)
+    name = entity.get("name") or entity.get("description")
+    if not name:
+        return ""
+    return _turtle_reference_link(kind, name, entity)
+
+
+def _render_url_reference(payload: Any) -> str:
+    url = ""
+    label = ""
+    if isinstance(payload, dict):
+        url = _safe_reference_url(
+            _reference_value(payload, "url", "link", "content_url", "source_url")
+        )
+        label = _bounded_reference_text(
+            _reference_value(payload, "title", "name", "text", "label"),
+            180,
+        )
+    elif isinstance(payload, list):
+        for value in payload:
+            if not url:
+                url = _safe_reference_url(value)
+            elif not label:
+                label = _bounded_reference_text(value, 180)
+    else:
+        url = _safe_reference_url(payload)
+    if not url:
+        return _markdown_reference_label(label)
+    if not label:
+        label = urlparse(url).hostname or "查看链接"
+    return f"[{_markdown_reference_label(label, '查看链接')}]({url})"
+
+
+def _product_items(payload: Any) -> list[dict[str, str]]:
+    if not isinstance(payload, dict):
+        return []
+    selections = payload.get("selections") or []
+    tags = payload.get("tags") or []
+    items: list[dict[str, str]] = []
+    for idx, selection in enumerate(selections):
+        name = ""
+        url = ""
+        if isinstance(selection, dict):
+            name = _bounded_reference_text(
+                _reference_value(selection, "name", "title", "label"),
+                180,
+            )
+            url = _safe_reference_url(
+                _reference_value(selection, "url", "link", "source_url")
+            )
+        elif isinstance(selection, list):
+            candidates = [
+                _bounded_reference_text(value, 180)
+                for value in selection
+                if isinstance(value, str)
+            ]
+            name = candidates[1] if len(candidates) > 1 else (candidates[0] if candidates else "")
+        else:
+            name = _bounded_reference_text(selection, 180)
+        tag_value = tags[idx] if idx < len(tags) else ""
+        if isinstance(tag_value, list):
+            tag = " · ".join(
+                filter(None, (_bounded_reference_text(value, 80) for value in tag_value))
+            )
+        else:
+            tag = _bounded_reference_text(tag_value, 160)
+        if name:
+            items.append({"name": name, "tag": tag, "url": url})
+        if len(items) >= 10:
+            break
+    return items
+
+
+def _render_products_reference(payload: Any) -> str:
