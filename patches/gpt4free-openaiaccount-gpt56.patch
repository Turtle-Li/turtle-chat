+def _render_product_reference(
+    reference_type: str,
+    payload: Any,
+    references: "ContentReferences",
+) -> str:
+    if reference_type == "product_entity":
+        entity = _entity_from_payload(payload)
+        if entity.get("name"):
+            return _render_entity_reference(payload, "product")
+    reference = _select_content_reference(reference_type, payload, references)
+    items = _product_reference_items(payload, reference)
+    if items:
