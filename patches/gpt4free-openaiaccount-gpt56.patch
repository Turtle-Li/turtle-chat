+    @classmethod
+    def iter_handoff_items(
+        cls,
+        value: Any,
+        expected_topic: str,
+        current_topic: Optional[str] = None,
+    ) -> Iterator[str]:
+        if isinstance(value, dict):
+            nested_topic = value.get("topic_id")
+            if isinstance(nested_topic, str) and nested_topic:
+                current_topic = nested_topic
+            encoded_item = value.get("encoded_item")
+            if (
+                isinstance(encoded_item, str)
+                and encoded_item
+                and current_topic in {None, expected_topic, "conversations"}
+            ):
+                yield encoded_item
+            for nested in value.values():
+                yield from cls.iter_handoff_items(nested, expected_topic, current_topic)
+        elif isinstance(value, list):
+            for nested in value:
+                yield from cls.iter_handoff_items(nested, expected_topic, current_topic)
+
+    @classmethod
+    def handoff_frame_done(
+        cls,
+        value: Any,
+        expected_topic: str,
+        current_topic: Optional[str] = None,
+    ) -> bool:
+        if isinstance(value, dict):
+            nested_topic = value.get("topic_id")
+            if isinstance(nested_topic, str) and nested_topic:
+                current_topic = nested_topic
+            if (
+                value.get("type") in {"done", "message_stream_complete"}
+                and current_topic in {None, expected_topic, "conversations"}
+            ):
+                return True
+            return any(
+                cls.handoff_frame_done(nested, expected_topic, current_topic)
+                for nested in value.values()
+            )
+        if isinstance(value, list):
+            return any(
+                cls.handoff_frame_done(nested, expected_topic, current_topic)
+                for nested in value
+            )
+        return False
