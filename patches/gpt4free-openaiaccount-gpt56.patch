+    reference = _select_content_reference(reference_type, payload, references)
+    images = _standalone_reference_images(payload, reference)
+    queries = _image_group_queries(payload)
+    if not queries and isinstance(reference, dict):
+        queries = _image_group_queries(reference)
+    if not images:
+        return _reference_fallback_text(reference_type, references, payload)
+    return _turtle_reference_link(
