+"""Control-plane client for moving media outside the OpenaiAccount host."""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import json
+import os
+import random
+import re
+import ssl
+import time
+import urllib.error
+import urllib.request
+import uuid
+from dataclasses import dataclass
+from typing import Any
+from urllib.parse import parse_qs, urlparse
+
+import certifi
+from Crypto.Cipher import AES
+
+
+SOURCE_ENVELOPE_KEY_CONTEXT = b"turtle-media-auth-key-v1\0"
+SOURCE_ENVELOPE_AAD = b"turtle-media-source-v1"
+MODEL_SOURCE_CONTEXT = b"turtle-model-source-v1\0"
+CHATGPT_MEDIA_HOST = "chatgpt.com"
+CHATGPT_MEDIA_PATH_PREFIX = "/backend-api/estuary/content"
+CHATGPT_INTERPRETER_DOWNLOAD_RE = re.compile(
+    r"^/backend-api/conversation/(?P<conversation_id>[A-Za-z0-9_-]{8,160})"
+    r"/interpreter/download$"
+)
+SAFE_UPSTREAM_ID_RE = re.compile(r"^[A-Za-z0-9_-]{8,160}$")
+MODEL_SOURCE_ID_RE = re.compile(r"^[0-9a-f]{64}$")
+MODEL_INPUT_MAX_BYTES = 20 * 1024**2
+CONTROL_RESPONSE_MAX_BYTES = 1024 * 1024
+CONTROL_RETRYABLE_STATUSES = frozenset({408, 409, 425, 429, 500, 502, 503, 504})
+CONTROL_RETRY_BASE_SECONDS = 0.35
+CONTROL_RETRY_JITTER_SECONDS = 0.15
+SAFE_ERROR_CODE_RE = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
+SAFE_ERROR_PHASES = frozenset({"probe", "source", "destination", "transfer"})
+SAFE_ERROR_SOURCES = frozenset({"primary", "fallback"})
+SAFE_LEGACY_ERROR_DETAILS = frozenset(
+    {
+        "media pump request failed",
+        "source request failed",
+        "source redirect limit exceeded",
+        "source probe failed",
+        "source size is unavailable",
+        "source exceeds transfer limit",
+        "source download failed",
+        "source size changed",
+        "source content type changed",
+        "transferred size mismatch",
+        "large source size is unavailable",
+        "destination upload failed",
+    }
+)
+SSL_CONTEXT = ssl.create_default_context(cafile=certifi.where())
+
+
+class MediaPumpError(RuntimeError):
+    pass
+
+
+class MediaPumpRequestError(MediaPumpError):
+    def __init__(
+        self,
+        *,
+        status: int | None,
+        code: str,
+        phase: str | None,
+        source: str | None,
+        retryable: bool,
+        structured: bool,
+    ):
+        self.status = status
+        self.code = code
+        self.phase = phase
+        self.source = source
+        self.retryable = retryable
+        self.structured = structured
+        self.attempts = 1
+        super().__init__(self._message())
+
+    def _message(self) -> str:
+        label = self.phase if self.phase in SAFE_ERROR_PHASES else "request"
+        context = []
+        if self.status is not None:
+            context.append(f"HTTP {self.status}")
+        context.append(f"code={self.code}")
+        if self.source in SAFE_ERROR_SOURCES:
+            context.append(f"source={self.source}")
+        attempts = f" after {self.attempts} attempts" if self.attempts > 1 else ""
+        return f"external media pump {label} failed{attempts} ({', '.join(context)})"
+
+    def set_attempts(self, attempts: int) -> None:
+        self.attempts = max(1, int(attempts))
+        self.args = (self._message(),)
+
