+    @staticmethod
+    def get_handoff_topic(event: dict) -> Optional[str]:
+        options = event.get("options")
+        if isinstance(options, list):
+            for option in options:
+                if not isinstance(option, dict) or option.get("type") != "subscribe_ws_topic":
+                    continue
+                topic = option.get("topic_id")
+                if isinstance(topic, str) and topic.startswith("conversation-turn-") and len(topic) <= 256:
+                    return topic
