+def _private_input_file_cache_key(source: ModelMediaSource) -> str:
+    """Hash the immutable source location without retaining signed URLs."""
+    parsed = urlparse(source.primary_url)
+    hostname = str(parsed.hostname or "").casefold()
+    try:
+        port = parsed.port
+    except ValueError:
+        port = None
+    authority = f"{hostname}:{port}" if port is not None else hostname
+    canonical = f"{parsed.scheme.casefold()}://{authority}{parsed.path}"
+    return hashlib.sha256(
+        PRIVATE_INPUT_FILE_CACHE_KEY_CONTEXT + canonical.encode("utf-8")
+    ).hexdigest()
+
+
+def _record_pump_metric(metrics: dict, result: dict, *, transferred: bool = False) -> None:
+    metrics["transfer_count" if transferred else "probe_count"] += 1
+    metrics["retry_count"] += max(0, int(result.get("retry_count") or 0))
+    if transferred:
+        metrics["transfer_bytes"] += max(0, int(result.get("size") or 0))
+    cache = result.get("cdn_cache")
+    if cache == "hit":
+        metrics["cdn_hit"] += 1
+    elif cache == "miss":
+        metrics["cdn_miss"] += 1
+    if result.get("source") == "fallback":
+        metrics["fallback_count"] += 1
+
