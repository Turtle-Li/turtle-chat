+
+        now = time.monotonic()
+        if now - cls._turtle_home_warmed_at < cls._turtle_home_warm_ttl_seconds:
+            return False
+        if cls._turtle_home_warm_lock is None:
+            cls._turtle_home_warm_lock = asyncio.Lock()
+        async with cls._turtle_home_warm_lock:
