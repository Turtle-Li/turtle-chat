+def _visible_progress_text(value: Any, *, limit: int = 180) -> str | None:
+    """Keep only an upstream-provided, user-visible progress label."""
+    if not isinstance(value, str):
+        return None
+    compact = " ".join(value.split())
+    if not compact:
+        return None
+    return compact[:limit]
+
+
+def _search_progress_labels(entries: Any, *, limit: int = 8) -> tuple[str, ...]:
+    """Expose compact page-level progress without leaking raw URLs."""
+    if not isinstance(entries, list):
+        return ()
+    labels: list[str] = []
+    seen: set[str] = set()
+    for entry in entries:
+        if not isinstance(entry, dict):
+            continue
+        raw_url = entry.get("url") or entry.get("link")
+        if not isinstance(raw_url, str):
+            continue
+        hostname = urlparse(raw_url).hostname
+        if not hostname:
+            continue
+        hostname = hostname.casefold().removeprefix("www.")
+        if hostname in seen:
+            continue
+        seen.add(hostname)
+        labels.append(f"正在查看 {hostname}")
+        if len(labels) >= limit:
+            break
+    if labels:
+        return tuple(labels)
+    return ()
+
+
+def _new_search_progress_labels(entries: Any, seen: set[str]) -> tuple[str, ...]:
+    """Return only page-progress labels not already emitted for this turn."""
+    labels: list[str] = []
+    for progress in _search_progress_labels(entries):
+        if progress in seen:
+            continue
+        seen.add(progress)
+        labels.append(progress)
+    return tuple(labels)
+
+
+def _search_progress_events(entries: Any, fields: Any) -> tuple[str, ...]:
+    """Infer an autonomous web search when cited HTTP pages first arrive."""
+    labels = _new_search_progress_labels(entries, fields.turtle_search_progress)
+    if not labels:
+        return ()
+    if fields.turtle_search_started:
+        return labels
+    fields.turtle_search_started = True
+    return ("正在搜索网页", *labels)
+
+
+def _visible_reasoning_recap(value: Any, *, limit: int = 12_000) -> str | None:
+    """Extract only ChatGPT's explicit user-visible reasoning recap fields."""
+    if isinstance(value, str):
+        text = value.strip()
+        return text[:limit] if text else None
+    if isinstance(value, list):
+        parts = [
+            text
+            for item in value
+            if (text := _visible_reasoning_recap(item, limit=limit))
+        ]
+        combined = "\n\n".join(parts).strip()
+        return combined[:limit] if combined else None
+    if not isinstance(value, dict):
+        return None
+    for key in ("content", "text", "parts", "chunks", "thoughts", "recap"):
+        text = _visible_reasoning_recap(value.get(key), limit=limit)
+        if text:
+            return text
+    return None
+
+
+def _new_reasoning_recap(value: Any, fields: Any) -> str | None:
+    """Deduplicate public recap messages that can arrive in patch and full frames."""
+    text = _visible_reasoning_recap(value)
+    if not text:
+        return None
+    signature = " ".join(text.split())
+    if signature in fields.turtle_reasoning_recaps:
+        return None
+    fields.turtle_reasoning_recaps.add(signature)
+    return text
+
+
+def _message_reasoning_recaps(message: Any) -> tuple[str, ...]:
+    """Read current and legacy public recap containers, never arbitrary metadata."""
+    if not isinstance(message, dict):
+        return ()
+    metadata = message.get("metadata")
+    if isinstance(metadata, dict):
+        turn_summary = _visible_reasoning_recap(metadata.get("turn_summary"))
+        if turn_summary:
+            return (turn_summary,)
+    content = message.get("content")
+    if not isinstance(content, dict):
+        return ()
+    content_type = content.get("content_type")
+    if content_type == "reasoning_recap":
+        recap = _visible_reasoning_recap(content.get("content"))
+        if recap:
+            return (recap,)
+        recap = _visible_reasoning_recap(content.get("parts"))
+        return (recap,) if recap else ()
+    if content_type != "thoughts":
+        return ()
+    recap = _visible_reasoning_recap(content.get("content"))
+    if recap:
+        return (recap,)
+    recaps: list[str] = []
+    for thought in content.get("thoughts") or []:
+        if not isinstance(thought, dict):
+            continue
+        text = _visible_reasoning_recap(
+            thought.get("content") or thought.get("chunks") or thought.get("summary")
+        )
+        if text:
+            recaps.append(text)
+    return tuple(recaps)
