+def _reference_fallback_text(
+    reference_type: str,
+    references: "ContentReferences",
+    payload: Any = None,
+) -> str:
+    if isinstance(payload, dict):
+        value = _reference_value(
+            payload,
+            "alt",
+            "prompt_text",
+            "text",
+            "value",
+            "result",
+            "title",
+            "name",
+        )
+        text = _bounded_reference_text(value, 320)
+        if text:
+            return _markdown_reference_label(text)
+    elif isinstance(payload, str):
+        text = _bounded_reference_text(payload, 320)
+        if text:
+            return _markdown_reference_label(text)
+    for reference in references.list:
+        if not isinstance(reference, dict) or reference.get("type") != reference_type:
+            continue
+        value = _reference_value(reference, "alt", "prompt_text", "title", "name")
+        text = _bounded_reference_text(value, 320)
+        if text:
+            return _markdown_reference_label(text)
+    return ""
+
+
+def _select_content_reference(
+    reference_type: str,
+    payload: Any,
+    references: "ContentReferences",
+) -> dict[str, Any] | None:
+    if isinstance(payload, int) and 0 <= payload < len(references.list):
+        candidate = references.list[payload]
+        if isinstance(candidate, dict):
+            return candidate
+    if isinstance(payload, dict):
+        for key in ("ref_index", "content_reference_index", "index"):
+            idx = payload.get(key)
+            if isinstance(idx, int) and 0 <= idx < len(references.list):
+                candidate = references.list[idx]
+                if isinstance(candidate, dict):
+                    return candidate
+    for reference in references.list:
+        if isinstance(reference, dict) and reference.get("type") == reference_type:
+            return reference
+    return None
+
+
+def _reference_item(mapping: Any) -> dict[str, str] | None:
+    if not isinstance(mapping, dict):
+        return None
+    product = mapping.get("product")
+    if isinstance(product, dict):
+        mapping = product
+    name = _bounded_reference_text(
+        _reference_value(
+            mapping,
+            "title",
+            "name",
+            "label",
+            "display_name",
+            "file_name",
+            "filename",
+        ),
+        180,
+    )
+    url = _safe_reference_url(
+        _reference_value(
+            mapping,
+            "url",
+            "link",
+            "source_url",
+            "page_url",
+        )
+    )
+    subtitle = _bounded_reference_text(
+        _reference_value(
+            mapping,
+            "subtitle",
+            "description",
+            "address",
+            "snippet",
+            "domain",
+            "site_name",
+            "merchant_name",
+            "mime_type",
+        ),
+        240,
+    )
+    price = mapping.get("price")
+    if isinstance(price, dict):
+        amount = _bounded_reference_text(
+            _reference_value(price, "display", "formatted", "amount"),
+            80,
+        )
+        currency = _bounded_reference_text(price.get("currency"), 16)
+        price_text = " ".join(filter(None, (amount, currency)))
+        subtitle = " · ".join(filter(None, (price_text, subtitle)))
+    elif isinstance(price, (str, int, float)):
+        subtitle = " · ".join(
+            filter(None, (_bounded_reference_text(str(price), 80), subtitle))
+        )
+    image_url = _safe_reference_url(
+        _reference_value(mapping, "image_url", "thumbnail_url")
+    )
+    if not name and url:
+        name = urlparse(url).hostname or "查看内容"
+    if not name:
+        return None
+    return {
+        "name": name,
+        "subtitle": subtitle,
+        "url": url,
+        "image_url": image_url,
+    }
+
