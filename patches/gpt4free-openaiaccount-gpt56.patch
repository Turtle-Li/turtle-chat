+def _bounded_reference_text(value: Any, limit: int = 240) -> str:
+    if isinstance(value, list):
+        value = "".join(part for part in value if isinstance(part, str))
+    if not isinstance(value, str):
+        return ""
+    return re.sub(r"\s+", " ", value).strip()[:limit]
+
+
+def _markdown_reference_label(value: Any, fallback: str = "") -> str:
+    label = _bounded_reference_text(value, 180) or fallback
+    return label.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]")
+
+
+def _safe_reference_url(value: Any) -> str:
+    if not isinstance(value, str) or len(value) > 8192:
+        return ""
+    try:
+        parsed = urlparse(value.strip())
+    except ValueError:
+        return ""
+    if (
+        parsed.scheme != "https"
+        or not parsed.hostname
+        or parsed.username is not None
+        or parsed.password is not None
+    ):
+        return ""
+    return parsed.geturl()
+
+
+def _turtle_reference_link(kind: str, label: str, payload: dict[str, Any]) -> str:
+    safe_kind = re.sub(r"[^a-z0-9_-]", "", kind.casefold())[:32]
+    if not safe_kind:
+        return _markdown_reference_label(label)
+    document = {"v": 1, **payload}
+    raw = json.dumps(
+        document,
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    images = document.get("images")
+    while len(raw) > MAX_TURTLE_REFERENCE_BYTES and isinstance(images, list) and images:
+        images.pop()
+        raw = json.dumps(
+            document,
+            ensure_ascii=False,
+            separators=(",", ":"),
+        ).encode("utf-8")
+    if len(raw) > MAX_TURTLE_REFERENCE_BYTES:
+        return _markdown_reference_label(label)
+    encoded = base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")
+    return (
+        f"[{_markdown_reference_label(label, '富内容')}]"
+        f"({TURTLE_REFERENCE_PATH}/{safe_kind}#{encoded})"
+    )
+
+
+def _content_reference_payload(sequence_content: str) -> tuple[str, Any]:
+    reference_type, separator, raw_payload = sequence_content.partition("\n")
+    reference_type = reference_type.strip().casefold()
+    if not separator or not raw_payload.strip():
+        return reference_type, None
+    try:
+        return reference_type, json.loads(raw_payload.strip())
+    except (TypeError, ValueError):
+        return reference_type, None
+
+
+def _reference_value(reference: dict[str, Any], *keys: str) -> Any:
+    for key in keys:
+        value = reference.get(key)
+        if value not in (None, "", [], {}):
+            return value
+    return None
+
+
+def _image_group_queries(payload: Any) -> list[str]:
+    if not isinstance(payload, dict):
+        return []
+    value = payload.get("query")
+    values = value if isinstance(value, list) else [value]
+    queries: list[str] = []
+    for item in values:
+        query = _bounded_reference_text(item, 240)
+        if query and query.casefold() not in {entry.casefold() for entry in queries}:
+            queries.append(query)
+        if len(queries) >= 8:
+            break
+    return queries
+
+
+def _find_image_group_reference(
+    queries: list[str],
+    references: "ContentReferences",
+) -> dict[str, Any] | None:
+    candidates = [
+        reference
+        for reference in references.list
+        if isinstance(reference, dict) and reference.get("type") == "image_group"
+    ]
+    if not candidates:
+        return None
+    wanted = {query.casefold() for query in queries}
+
+    def score(reference: dict[str, Any]) -> tuple[int, int]:
+        found: set[str] = set()
+        for image in reference.get("images") or []:
+            if not isinstance(image, dict):
+                continue
+            query = _bounded_reference_text(image.get("image_search_query"), 240)
+            if query:
+                found.add(query.casefold())
+        return len(wanted & found), len(found)
+
+    return max(candidates, key=score)
+
+
+def _image_group_images(reference: dict[str, Any] | None) -> list[dict[str, str]]:
+    if not isinstance(reference, dict):
+        return []
+    raw_images = reference.get("images") or []
+    if not raw_images:
+        raw_images = reference.get("optimistic_image_results") or []
+    images: list[dict[str, str]] = []
+    seen: set[str] = set()
+    for wrapper in raw_images:
+        if not isinstance(wrapper, dict):
+            continue
+        result = wrapper.get("image_result")
+        if not isinstance(result, dict):
+            result = wrapper
+        image_url = _safe_reference_url(
+            _reference_value(
+                result,
+                "content_url",
+                "image_url",
+                "thumbnail_url",
+            )
+            or _reference_value(wrapper, "content_url", "image_url", "thumbnail_url")
+        )
+        if not image_url or image_url in seen:
+            continue
+        seen.add(image_url)
+        source_url = _safe_reference_url(
+            _reference_value(result, "source_url", "page_url", "url")
+            or _reference_value(wrapper, "source_url", "page_url", "url")
+        )
+        image = {
+            "image_url": image_url,
+            "title": _bounded_reference_text(
+                _reference_value(result, "title", "name", "alt")
+                or _reference_value(wrapper, "title", "name", "alt"),
+                240,
+            ),
+            "source_url": source_url,
+            "source_name": _bounded_reference_text(
+                _reference_value(result, "source_name", "site_name", "domain")
+                or _reference_value(wrapper, "source_name", "site_name", "domain"),
+                120,
+            ),
+        }
+        query = _bounded_reference_text(wrapper.get("image_search_query"), 240)
+        if query:
+            image["query"] = query
+        images.append(image)
+        if len(images) >= MAX_TURTLE_REFERENCE_IMAGES:
+            break
+    return images
+
+
+def _image_group_needs_metadata(
+    payload: Any,
+    references: "ContentReferences",
+    *,
+    finished: bool,
+) -> bool:
+    if finished:
+        return False
+    queries = _image_group_queries(payload)
+    reference = _find_image_group_reference(queries, references)
+    return not _image_group_images(reference)
+
+
+def _render_image_group_reference(
+    payload: Any,
+    references: "ContentReferences",
+) -> str:
+    queries = _image_group_queries(payload)
+    reference = _find_image_group_reference(queries, references)
+    images = _image_group_images(reference)
+    candidate_count = sum(
+        1
+        for item in references.list
+        if isinstance(item, dict) and item.get("type") == "image_group"
+    )
+    debug.log(
+        "OpenaiChat: Rich image group resolved "
+        f"queries={len(queries)} "
+        f"candidates={candidate_count} "
+        f"images={len(images)}"
+    )
+    layout = ""
+    aspect_ratio = ""
+    if isinstance(payload, dict):
+        layout = _bounded_reference_text(payload.get("layout"), 24).casefold()
+        aspect_ratio = _bounded_reference_text(payload.get("aspect_ratio"), 16)
+    if layout not in {"carousel", "bento", "grid"}:
+        layout = _bounded_reference_text(
+            reference.get("layout") if isinstance(reference, dict) else "",
+            24,
+        ).casefold()
+    if layout not in {"carousel", "bento", "grid"}:
+        layout = "carousel"
+    if not re.fullmatch(r"\d{1,2}:\d{1,2}", aspect_ratio):
+        aspect_ratio = _bounded_reference_text(
+            reference.get("aspect_ratio") if isinstance(reference, dict) else "",
+            16,
+        )
+    if not re.fullmatch(r"\d{1,2}:\d{1,2}", aspect_ratio):
+        aspect_ratio = "16:9"
+    label = f"相关图片：{queries[0]}" if queries else "相关图片"
+    return _turtle_reference_link(
+        "image-group",
+        label,
+        {
+            "queries": queries,
+            "layout": layout,
+            "aspect_ratio": aspect_ratio,
+            "images": images,
+        },
+    )
+
