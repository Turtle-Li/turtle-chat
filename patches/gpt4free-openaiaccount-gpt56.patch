+def _is_safe_sandbox_zip_path(path: str) -> bool:
+    if not path.startswith("/mnt/data/"):
+        return False
+    filename = path.removeprefix("/mnt/data/")
+    return (
+        1 <= len(filename) <= 220
+        and "/" not in filename
+        and "\\" not in filename
+        and ".." not in filename
+        and all(ord(character) >= 32 for character in filename)
+        and filename.lower().endswith(".zip")
+    )
+
+
+def _sandbox_file_ids(conversation: "Conversation") -> tuple[str, str] | None:
+    conversation_id = str(getattr(conversation, "conversation_id", "") or "")
+    message_id = str(getattr(conversation, "message_id", "") or "")
+    if (
+        SAFE_UPSTREAM_ID_RE.fullmatch(conversation_id)
+        and SAFE_UPSTREAM_ID_RE.fullmatch(message_id)
+    ):
+        return conversation_id, message_id
+    return None
+
+
+async def resolve_sandbox_file_source(
+    session: StreamSession,
+    sandbox_path: str,
+    auth_result: AuthResult,
+    conversation: "Conversation",
+) -> str:
+    """Resolve ChatGPT's small interpreter metadata JSON, never the ZIP body."""
+    cached = conversation.turtle_sandbox_file_sources.get(sandbox_path)
+    if cached:
+        return cached
+    upstream_ids = _sandbox_file_ids(conversation)
+    if upstream_ids is None:
+        raise MediaPumpError("ChatGPT ZIP response IDs are unavailable")
+    conversation_id, message_id = upstream_ids
+    query = urlencode(
+        {
+            "message_id": message_id,
+            "sandbox_path": sandbox_path,
+        }
+    )
+    metadata_url = (
+        f"https://chatgpt.com/backend-api/conversation/{conversation_id}"
+        f"/interpreter/download?{query}"
+    )
+    metadata = None
+    download_url = ""
+    for attempt in range(15):
+        try:
+            async with session.get(metadata_url, headers=auth_result.headers) as response:
+                await raise_for_status(response, "Resolve generated ZIP failed")
+                metadata = await response.json()
+        except Exception as exc:
+            raise MediaPumpError("ChatGPT ZIP download metadata is unavailable") from exc
+        if not isinstance(metadata, dict):
+            raise MediaPumpError("ChatGPT ZIP download metadata is invalid")
+        candidate = metadata.get("download_url")
+        if isinstance(candidate, str) and candidate.strip():
+            download_url = candidate.strip()
+            break
+        if attempt == 14:
+            raise MediaPumpError("ChatGPT ZIP download is not ready")
+        await asyncio.sleep(min(0.5 * (2 ** attempt), 5.0))
+
+    # Interpreter metadata is intentionally sparse and its descriptive fields vary
+    # by backend. The safe filename comes from the reviewed sandbox path above;
+    # Media Pump authoritatively probes size/type before transferring to storage.
+    try:
+        source = seal_media_sources(
+            download_url,
+            auth_result.headers,
+        )
+    except MediaPumpError as exc:
+        raise MediaPumpError("ChatGPT ZIP source is outside the media allowlist") from exc
+    conversation.turtle_sandbox_file_sources[sandbox_path] = source
+    return source
+
+
+async def seal_sandbox_file_links(
+    session: StreamSession,
+    value: str,
+    auth_result: AuthResult,
+    conversation: "Conversation",
+) -> str:
+    """Replace official sandbox ZIP links with short-lived Media Pump sources."""
+    if _sandbox_file_ids(conversation) is None:
+        return value
+    output = []
+    cursor = 0
+    for match in SANDBOX_FILE_URL_RE.finditer(value):
+        output.append(value[cursor : match.start()])
+        sandbox_path = match.group("path")
+        if not _is_safe_sandbox_zip_path(sandbox_path):
+            output.append(match.group(0))
+            cursor = match.end()
+            continue
+        try:
+            output.append(
+                await resolve_sandbox_file_source(
+                    session,
+                    sandbox_path,
+                    auth_result,
+                    conversation,
+                )
+            )
+        except MediaPumpError:
+            if strict_media_mode():
+                raise
+            output.append(match.group(0))
+        cursor = match.end()
+    output.append(value[cursor:])
+    return "".join(output)
+
+
+async def rewrite_sandbox_file_stream(
+    session: StreamSession,
+    value: str,
+    pending: str,
+    auth_result: AuthResult,
+    conversation: "Conversation",
+    *,
+    final: bool = False,
+) -> tuple[str, str]:
+    """Hold only an incomplete sandbox URL while preserving normal streaming."""
+    combined = pending + value
+    if final:
+        return (
+            await seal_sandbox_file_links(
+                session,
+                combined,
+                auth_result,
+                conversation,
+            ),
+            "",
+        )
+
+    marker_index = combined.lower().rfind(SANDBOX_FILE_PREFIX)
+    if marker_index >= 0:
+        candidate = combined[marker_index:]
+        complete_link = SANDBOX_FILE_URL_RE.search(candidate)
+        if (
+            len(candidate) <= 512
+            and (
+                ")" not in candidate
+                or (complete_link is not None and _sandbox_file_ids(conversation) is None)
+            )
+        ):
+            output = await seal_sandbox_file_links(
+                session,
+                combined[:marker_index],
+                auth_result,
+                conversation,
+            )
+            return (
+                output,
+                candidate,
+            )
+
+    lower_combined = combined.lower()
+    partial_length = 0
+    for length in range(1, len(SANDBOX_FILE_PREFIX)):
+        if lower_combined.endswith(SANDBOX_FILE_PREFIX[:length]):
+            partial_length = length
+    if partial_length:
+        output = combined[:-partial_length]
+        pending = combined[-partial_length:]
+    else:
+        output = combined
+        pending = ""
+    return (
+        await seal_sandbox_file_links(
+            session,
+            output,
+            auth_result,
+            conversation,
+        ),
+        pending,
+    )


