+@dataclass(frozen=True)
+class ModelMediaSource:
+    primary_url: str
+    fallback_url: str | None = None
+    media_id: str | None = None
+
+
+def strict_media_mode() -> bool:
+    return os.getenv("TURTLE_MEDIA_STRICT", "true").strip().lower() not in {
+        "0",
+        "false",
+        "no",
+        "off",
+    }
+
+
+def _configuration() -> tuple[str, str, int]:
+    base_url = os.getenv("TURTLE_MEDIA_PUMP_URL", "").strip().rstrip("/")
+    secret = os.getenv("TURTLE_MEDIA_PUMP_SECRET", "").strip()
+    timeout = int(os.getenv("TURTLE_MEDIA_PUMP_TIMEOUT_SECONDS", "1800"))
+    try:
+        parsed = urlparse(base_url)
+    except ValueError as exc:
+        raise MediaPumpError("external media pump configuration is invalid") from exc
+    if (
+        parsed.scheme != "https"
+        or not parsed.hostname
+        or parsed.username
+        or parsed.password
+        or parsed.query
+        or parsed.fragment
+        or parsed.path not in {"", "/"}
+    ):
+        raise MediaPumpError("external media pump requires an HTTPS URL")
+    if len(secret) < 32:
+        raise MediaPumpError("external media pump secret is not configured")
+    return base_url, secret, timeout
+
+
+def _retry_attempts() -> int:
+    try:
+        attempts = int(os.getenv("TURTLE_MEDIA_PUMP_RETRY_ATTEMPTS", "2"))
+    except ValueError as exc:
+        raise MediaPumpError("external media pump retry configuration is invalid") from exc
+    if attempts < 1 or attempts > 3:
+        raise MediaPumpError("external media pump retry configuration is invalid")
+    return attempts
+
+
+def _decode_b64url(value: str) -> bytes:
+    if not value or not re.fullmatch(r"[A-Za-z0-9_-]+", value):
+        raise MediaPumpError("managed model source token is invalid")
+    try:
+        return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))
+    except (ValueError, TypeError) as exc:
+        raise MediaPumpError("managed model source token is invalid") from exc
+
+
+def _validated_https_url(value: Any, label: str) -> str:
+    if not isinstance(value, str) or len(value) > 16_384:
+        raise MediaPumpError(f"{label} is invalid")
+    try:
+        parsed = urlparse(value)
+    except ValueError as exc:
+        raise MediaPumpError(f"{label} is invalid") from exc
+    if (
+        parsed.scheme != "https"
+        or not parsed.hostname
+        or parsed.username
+        or parsed.password
+        or parsed.fragment
+    ):
+        raise MediaPumpError(f"{label} must be an HTTPS URL")
+    return value
+
+
+def open_model_source(image_url: Any) -> ModelMediaSource:
+    """Verify Open WebUI's CDN/COS source envelope before Pump use."""
+    if isinstance(image_url, str):
+        return ModelMediaSource(_validated_https_url(image_url, "model source"))
+    if not isinstance(image_url, dict):
+        raise MediaPumpError("managed model source is invalid")
+    if any(key not in {"url", "detail", "turtle_source"} for key in image_url):
+        raise MediaPumpError("managed model source contains an unexpected field")
+    primary_url = _validated_https_url(image_url.get("url"), "primary model source")
+    token = image_url.get("turtle_source")
+    if token is None:
+        return ModelMediaSource(primary_url)
+    if not isinstance(token, str) or len(token) > 48_000 or token.count(".") != 1:
+        raise MediaPumpError("managed model source token is invalid")
+    encoded, supplied_signature = token.split(".", 1)
+    if not re.fullmatch(r"[A-Za-z0-9_-]+", encoded):
+        raise MediaPumpError("managed model source token is invalid")
+    _, secret, _ = _configuration()
+    expected_signature = hmac.new(
+        secret.encode("utf-8"),
+        MODEL_SOURCE_CONTEXT + encoded.encode("ascii"),
+        hashlib.sha256,
+    ).digest()
+    if not hmac.compare_digest(_decode_b64url(supplied_signature), expected_signature):
+        raise MediaPumpError("managed model source token is invalid")
+    try:
+        payload = json.loads(_decode_b64url(encoded))
+    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
+        raise MediaPumpError("managed model source token is invalid") from exc
+    if (
+        not isinstance(payload, dict)
+        or any(
+            key not in {"v", "exp", "id", "primary_url", "fallback_url"}
+            for key in payload
+        )
+        or payload.get("v") != 1
+        or not isinstance(payload.get("exp"), int)
+        or not MODEL_SOURCE_ID_RE.fullmatch(str(payload.get("id") or ""))
+    ):
+        raise MediaPumpError("managed model source token is invalid")
+    now = int(time.time())
+    if payload["exp"] <= now or payload["exp"] > now + 900:
+        raise MediaPumpError("managed model source token has expired")
+    sealed_primary = _validated_https_url(
+        payload.get("primary_url"),
+        "sealed primary model source",
+    )
+    if not hmac.compare_digest(sealed_primary, primary_url):
+        raise MediaPumpError("managed model source URL does not match its token")
+    fallback = payload.get("fallback_url")
+    if fallback is not None:
+        fallback = _validated_https_url(fallback, "fallback model source")
+        if fallback == primary_url:
+            fallback = None
+    return ModelMediaSource(
+        primary_url=primary_url,
+        fallback_url=fallback,
+        media_id=payload["id"],
+    )
+
+
+def _source_payload(source: ModelMediaSource | str) -> dict:
+    normalized = (
+        source
+        if isinstance(source, ModelMediaSource)
+        else ModelMediaSource(_validated_https_url(source, "model source"))
+    )
+    return {
+        "source_url": normalized.primary_url,
+        **(
+            {"fallback_url": normalized.fallback_url}
+            if normalized.fallback_url
+            else {}
+        ),
+    }
+
+
+def _source_metrics(result: dict) -> dict:
+    source = str(result.get("source") or "primary")
+    cache = str(result.get("cdn_cache") or "unknown")
+    return {
+        "source": source if source in {"primary", "fallback"} else "primary",
+        "cdn_cache": cache if cache in {"hit", "miss", "unknown"} else "unknown",
+    }
+
+
+def _authorization_header(headers: dict[str, str]) -> str:
+    authorization = next(
+        (str(value) for name, value in (headers or {}).items() if str(name).lower() == "authorization"),
+        "",
+    )
+    if (
+        len(authorization) < 32
+        or len(authorization) > 8192
+        or not authorization.startswith("Bearer ")
+        or "\r" in authorization
+        or "\n" in authorization
+    ):
+        raise MediaPumpError("ChatGPT media authorization is unavailable")
+    return authorization
+
+
+def _is_allowed_chatgpt_media_url(parsed) -> bool:
+    if (
+        parsed.path == CHATGPT_MEDIA_PATH_PREFIX
+        or parsed.path.startswith(f"{CHATGPT_MEDIA_PATH_PREFIX}/")
+    ):
+        return True
+
+    if not CHATGPT_INTERPRETER_DOWNLOAD_RE.fullmatch(parsed.path):
+        return False
+    try:
+        query = parse_qs(parsed.query, keep_blank_values=True, strict_parsing=True)
+    except ValueError:
+        return False
+    if set(query) != {"message_id", "sandbox_path"}:
+        return False
+    if len(query["message_id"]) != 1 or len(query["sandbox_path"]) != 1:
+        return False
+    message_id = query["message_id"][0]
+    sandbox_path = query["sandbox_path"][0]
+    if not SAFE_UPSTREAM_ID_RE.fullmatch(message_id):
+        return False
+    if not sandbox_path.startswith("/mnt/data/"):
+        return False
+    filename = sandbox_path.removeprefix("/mnt/data/")
+    return (
+        1 <= len(filename) <= 220
+        and "/" not in filename
+        and "\\" not in filename
+        and ".." not in filename
+        and all(ord(character) >= 32 for character in filename)
+        and filename.lower().endswith(".zip")
+    )
+
+
+def seal_media_source(source_url: str, headers: dict[str, str]) -> str:
+    """Create a short-lived opaque Worker URL without exposing account auth."""
+    base_url, secret, _ = _configuration()
+    try:
+        parsed = urlparse(source_url)
+    except ValueError as exc:
+        raise MediaPumpError("ChatGPT media URL is invalid") from exc
+    if (
+        parsed.scheme != "https"
+        or parsed.hostname != CHATGPT_MEDIA_HOST
+        or parsed.port not in {None, 443}
+        or parsed.username
+        or parsed.password
+        or parsed.fragment
+        or not _is_allowed_chatgpt_media_url(parsed)
+    ):
+        raise MediaPumpError("ChatGPT media URL is outside the authenticated relay allowlist")
+    ttl = int(os.getenv("TURTLE_MEDIA_AUTH_TTL_SECONDS", "600"))
+    if ttl < 60 or ttl > 900:
+        raise MediaPumpError("ChatGPT media authorization TTL is invalid")
+    payload = json.dumps(
+        {
+            "v": 1,
+            "exp": int(time.time()) + ttl,
+            "source_url": source_url,
+            "headers": {"authorization": _authorization_header(headers)},
+        },
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    key = hashlib.sha256(SOURCE_ENVELOPE_KEY_CONTEXT + secret.encode("utf-8")).digest()
+    cipher = AES.new(key, AES.MODE_GCM, nonce=os.urandom(12), mac_len=16)
+    cipher.update(SOURCE_ENVELOPE_AAD)
+    ciphertext, tag = cipher.encrypt_and_digest(payload)
+    token = base64.urlsafe_b64encode(cipher.nonce + ciphertext + tag).rstrip(b"=").decode("ascii")
+    return f"{base_url}/v1/source/{token}"
+
+
+def seal_media_sources(source_urls, headers: dict[str, str]):
+    if isinstance(source_urls, str):
+        return seal_media_source(source_urls, headers)
+    return [seal_media_source(source_url, headers) for source_url in source_urls]
+
+
+def _request_headers(secret: str, path: str, body: bytes) -> dict[str, str]:
+    timestamp = str(int(time.time()))
+    nonce = uuid.uuid4().hex
+    digest = hashlib.sha256(body).hexdigest()
+    canonical = "\n".join(["POST", path, timestamp, nonce, digest]).encode("utf-8")
+    signature = hmac.new(secret.encode("utf-8"), canonical, hashlib.sha256).hexdigest()
+    return {
+        "Content-Type": "application/json",
+        "Accept": "application/json",
+        "User-Agent": "turtle-media-pump-control/1.0",
+        "X-Turtle-Pump-Timestamp": timestamp,
+        "X-Turtle-Pump-Nonce": nonce,
+        "X-Turtle-Pump-Signature": signature,
+    }
+
+
+def _safe_http_error(path: str, exc: urllib.error.HTTPError) -> MediaPumpRequestError:
+    status = int(exc.code)
+    response_payload = None
+    try:
+        raw = exc.read(CONTROL_RESPONSE_MAX_BYTES + 1)
+        if len(raw) <= CONTROL_RESPONSE_MAX_BYTES:
+            candidate = json.loads(raw)
+            if isinstance(candidate, dict):
+                response_payload = candidate
+    except (OSError, UnicodeDecodeError, ValueError):
+        response_payload = None
+
+    code = None
+    phase = None
+    source = None
+    server_retryable = False
+    structured = False
+    if response_payload is not None:
+        candidate_code = response_payload.get("code")
+        if isinstance(candidate_code, str) and SAFE_ERROR_CODE_RE.fullmatch(candidate_code):
+            code = candidate_code
+            structured = True
+        detail = response_payload.get("detail")
+        if code is None and isinstance(detail, str) and detail in SAFE_LEGACY_ERROR_DETAILS:
+            code = re.sub(r"[^a-z0-9]+", "_", detail.lower()).strip("_")
+        candidate_phase = response_payload.get("phase")
+        if isinstance(candidate_phase, str) and candidate_phase in SAFE_ERROR_PHASES:
+            phase = candidate_phase
+        candidate_source = response_payload.get("source")
+        if isinstance(candidate_source, str) and candidate_source in SAFE_ERROR_SOURCES:
+            source = candidate_source
+        server_retryable = response_payload.get("retryable") is True
+
+    if code is None:
+        code = f"http_{status}"
+    if phase is None:
+        phase = "probe" if path == "/v1/probe" else "transfer"
+    retryable = status in CONTROL_RETRYABLE_STATUSES and (
+        path == "/v1/probe" or server_retryable
+    )
+    return MediaPumpRequestError(
+        status=status,
+        code=code,
+        phase=phase,
+        source=source,
+        retryable=retryable,
+        structured=structured,
+    )
+
+
+def _post_once_sync(path: str, payload: dict) -> dict:
+    base_url, secret, timeout = _configuration()
+    body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+    request = urllib.request.Request(
+        f"{base_url}{path}",
+        data=body,
+        headers=_request_headers(secret, path, body),
+        method="POST",
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=timeout, context=SSL_CONTEXT) as response:
+            if response.status < 200 or response.status >= 300:
+                raise MediaPumpRequestError(
+                    status=int(response.status),
+                    code=f"http_{int(response.status)}",
+                    phase="probe" if path == "/v1/probe" else "transfer",
+                    source=None,
+                    retryable=(
+                        path == "/v1/probe"
+                        and int(response.status) in CONTROL_RETRYABLE_STATUSES
+                    ),
+                    structured=False,
+                )
+            raw = response.read(CONTROL_RESPONSE_MAX_BYTES + 1)
+            if len(raw) > CONTROL_RESPONSE_MAX_BYTES:
+                raise MediaPumpRequestError(
+                    status=int(response.status),
+                    code="invalid_response",
+                    phase="probe" if path == "/v1/probe" else "transfer",
+                    source=None,
+                    retryable=path == "/v1/probe",
+                    structured=False,
+                )
+            result = json.loads(raw)
+    except urllib.error.HTTPError as exc:
+        raise _safe_http_error(path, exc) from exc
+    except MediaPumpError:
+        raise
+    except (OSError, ValueError, urllib.error.URLError) as exc:
+        raise MediaPumpRequestError(
+            status=None,
+            code="control_request_failed",
+            phase="probe" if path == "/v1/probe" else "transfer",
+            source=None,
+            retryable=path == "/v1/probe",
+            structured=False,
+        ) from exc
+    if not isinstance(result, dict):
+        raise MediaPumpRequestError(
+            status=None,
+            code="invalid_response",
+            phase="probe" if path == "/v1/probe" else "transfer",
+            source=None,
+            retryable=path == "/v1/probe",
+            structured=False,
+        )
+    return result
+
+
+def _safe_to_retry(path: str, error: MediaPumpRequestError) -> bool:
+    if not error.retryable:
+        return False
+    if path == "/v1/probe":
+        return True
+    return (
+        path == "/v1/transfers"
+        and error.structured
+        and error.phase == "source"
+        and error.source in SAFE_ERROR_SOURCES
+    )
+
+
+def _post_sync(path: str, payload: dict) -> dict:
+    attempts = _retry_attempts()
+    for attempt in range(1, attempts + 1):
+        try:
+            result = _post_once_sync(path, payload)
+            result["_control_attempts"] = attempt
+            return result
+        except MediaPumpRequestError as exc:
+            exc.set_attempts(attempt)
+            if attempt >= attempts or not _safe_to_retry(path, exc):
+                raise
+            delay = CONTROL_RETRY_BASE_SECONDS * (2 ** (attempt - 1))
+            time.sleep(delay + random.uniform(0, CONTROL_RETRY_JITTER_SECONDS))
+    raise AssertionError("unreachable media pump retry state")
+
+
+async def probe_media(source: ModelMediaSource | str) -> dict:
+    configured_max_bytes = int(
+        os.getenv(
+            "TURTLE_MEDIA_PUMP_MAX_INPUT_BYTES",
+            str(MODEL_INPUT_MAX_BYTES),
+        )
+    )
+    if configured_max_bytes <= 0:
+        raise MediaPumpError("external media pump input limit is invalid")
+    max_bytes = min(configured_max_bytes, MODEL_INPUT_MAX_BYTES)
+    result = await asyncio.to_thread(
+        _post_sync,
+        "/v1/probe",
+        {**_source_payload(source), "max_bytes": max_bytes},
+    )
+    size = int(result.get("size") or 0)
+    content_type = str(result.get("content_type") or "").split(";", 1)[0].lower()
+    if size <= 0 or not content_type:
+        raise MediaPumpError("external media probe is incomplete")
+    dimensions = {
+        name: int(result[name])
+        for name in ("width", "height")
+        if int(result.get(name) or 0) > 0
+    }
+    return {
+        "size": size,
+        "content_type": content_type,
+        "max_bytes": max_bytes,
+        "retry_count": max(0, int(result.get("_control_attempts") or 1) - 1),
+        **_source_metrics(result),
+        **dimensions,
+    }
+
+
+async def transfer_media(
+    *,
+    source: ModelMediaSource | str,
+    destination_url: str,
+    destination_headers: dict[str, str],
+    expected_size: int,
+    expected_content_type: str,
+    max_bytes: int,
+) -> dict:
+    result = await asyncio.to_thread(
+        _post_sync,
+        "/v1/transfers",
+        {
+            **_source_payload(source),
