#!/usr/bin/env bash
set -Eeuo pipefail

readonly DEPLOY_COMMAND=/opt/turtle-gpt/deploy/bin/deploy-release

if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy[[:space:]]([0-9a-f]{40})$ ]]; then
  exec "$DEPLOY_COMMAND" "${BASH_REMATCH[1]}"
fi

echo "This key is restricted to a Turtle production deployment." >&2
exit 64
