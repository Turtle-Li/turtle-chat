map $http_upgrade $turtle_connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_turtle_direct_client_ip $turtle_direct_api_client {
    default $http_x_turtle_direct_client_ip;
    '' $binary_remote_addr;
}

limit_req_zone $turtle_direct_api_client zone=turtle_direct_api_rate:10m rate=30r/s;
limit_conn_zone $turtle_direct_api_client zone=turtle_direct_api_connections:10m;

upstream turtle_webui {
    server open-webui-__TURTLE_SLOT__:8080;
    keepalive 32;
}

upstream turtle_gateway {
    server gateway-__TURTLE_SLOT__:8000;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    client_max_body_size 250m;

    location = /__turtle_router_health {
        default_type text/plain;
        return 200 "slot=__TURTLE_SLOT__\n";
    }

    location / {
        proxy_pass http://turtle_webui;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Turtle-Project-External-Prefix "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $turtle_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1900s;
        proxy_send_timeout 1900s;
    }
}

server {
    listen 8080;
    server_name api.chat.turtleligpt.com;
    client_max_body_size 9m;

    limit_req_status 429;
    limit_conn_status 429;
    error_page 429 = @turtle_direct_api_limited;

    location ^~ /v1/ {
        limit_req zone=turtle_direct_api_rate burst=90 nodelay;
        limit_conn turtle_direct_api_connections 64;

        rewrite ^/v1/(.*)$ /api/project/v1/$1 break;
        proxy_pass http://turtle_webui;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_turtle_direct_client_ip;
        proxy_set_header X-Forwarded-For $http_x_turtle_direct_client_ip;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Turtle-Direct-Client-IP "";
        proxy_set_header X-Turtle-Project-External-Prefix /v1;
        proxy_set_header Accept-Encoding identity;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1900s;
        proxy_send_timeout 1900s;
        add_header Cache-Control "no-store" always;
        add_header X-Accel-Buffering "no" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location @turtle_direct_api_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "1" always;
        return 429 '{"error":{"message":"Too many requests","type":"rate_limit_error"}}';
    }

    location / {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 404 '{"error":{"message":"Not found","type":"invalid_request_error"}}';
    }
}

server {
    listen 8000;
    server_name _;
    client_max_body_size 2m;

    location = /__turtle_router_health {
        default_type text/plain;
        return 200 "slot=__TURTLE_SLOT__\n";
    }

    location / {
        proxy_pass http://turtle_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 920s;
        proxy_send_timeout 920s;
    }
}
