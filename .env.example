# Public gateway authentication. Replace both values before any non-local use.
GATEWAY_API_KEY=replace-with-a-long-random-value
UPSTREAM_API_KEY=replace-with-a-different-long-random-value
# Host Claude workers default to UPSTREAM_API_KEY so Gateway and worker use the
# same private API credential. Set CLAUDE_WORKER_API_KEY only for an explicitly
# coordinated deployment override.
# CLAUDE_WORKER_API_KEY=replace-with-the-coordinated-worker-value

# Stable Open WebUI session signing and signed user identity forwarding.
# Use distinct long random values. Never commit the real values.
WEBUI_SECRET_KEY=replace-with-another-long-random-value
FORWARD_USER_INFO_HEADER_JWT_SECRET=replace-with-a-fourth-long-random-value

# Optional dedicated key for encrypting Tencent COS credentials in the
# Open WebUI data volume. If omitted, Turtle derives a separate Fernet key
# from WEBUI_SECRET_KEY. Set this before configuring COS and keep it stable.
TURTLE_STORAGE_MASTER_KEY=replace-with-a-fifth-long-random-value

# PostgreSQL and Redis use Docker secret files rather than plaintext Compose
# environment values. Generate distinct 32+ character values at these ignored
# paths before starting the stack; never reuse Sub2's databases or credentials.
#   .runtime/secrets/turtle_postgres_password
#   .runtime/secrets/turtle_redis_password
#   .runtime/secrets/turtle_login_control_secret

# Server-enforced chat queue limits. User and group limits are configured in
# the administrator console; these values are the outer Provider/global guard.
# Safety ceilings; healthy account-pool capacity is summed dynamically below them.
TURTLE_CHAT_MAX_CONCURRENCY=32
TURTLE_GPT_MAX_CONCURRENCY=24
TURTLE_CLAUDE_MAX_CONCURRENCY=4
# Open WebUI reads only the Gateway's sanitized account-group capacity and
# adds it as a fifth Redis FIFO limit before a ChatGPT request reaches Gateway.
TURTLE_ACCOUNT_POOL_ADMISSION_ENABLED=true
TURTLE_CHAT_QUEUE_TIMEOUT_SECONDS=120
TURTLE_CHAT_LEASE_SECONDS=1200
# Redis commands share a lazy bounded pool. A smaller in-process command gate
# makes bursts wait as cancellable coroutines instead of exhausting the pool.
TURTLE_REDIS_MAX_CONNECTIONS=100
TURTLE_REDIS_COMMAND_CONCURRENCY=64
TURTLE_REDIS_MAINTENANCE_CONCURRENCY=16
TURTLE_REDIS_WAKE_HEADS_PER_POOL=32
# Subscription authorization shares the bounded Redis pool above. Positive
# entries expire early with jitter and are always clamped to the real end time;
# pending/inactive entries use the shorter negative TTL.
TURTLE_SUBSCRIPTION_CACHE_TTL_SECONDS=120
TURTLE_SUBSCRIPTION_NEGATIVE_TTL_SECONDS=15
TURTLE_SUBSCRIPTION_LOCK_TTL_MS=5000
TURTLE_SUBSCRIPTION_LOCK_WAIT_MS=1500
TURTLE_SUBSCRIPTION_REDIS_TIMEOUT_MS=350
TURTLE_SUBSCRIPTION_DB_FALLBACK_CONCURRENCY=8

# Gateway account-pool leases are separate from the outer user/group queue.
# One account stays fixed after output begins. Before any response is exposed,
# 401/403, 429, or a local worker-client failure can safely fail over once per
# distinct account. Ambiguous transport/5xx failures are never replayed.
GATEWAY_ACCOUNT_LEASE_SECONDS=1200
GATEWAY_ACCOUNT_COOLDOWN_SECONDS=300
GATEWAY_ACCOUNT_FAILOVER_MAX_ATTEMPTS=3

# Track only exact upstream IDs created by Turtle. Local deletion schedules
# cleanup immediately and a periodic orphan/TTL scan provides durability.
# Keep execution false until the dedicated upstream delete acceptance passes.
GATEWAY_UPSTREAM_CLEANUP_ENABLED=true
GATEWAY_UPSTREAM_CLEANUP_EXECUTE=false
GATEWAY_UPSTREAM_CLEANUP_TTL_SECONDS=2592000
GATEWAY_UPSTREAM_CLEANUP_INTERVAL_SECONDS=300
GATEWAY_UPSTREAM_CLEANUP_BATCH_SIZE=20

# Loopback host service used by the administrator's per-account re-login flow.
# The runtime manifest contains only account IDs, isolated ports/profiles and
# LaunchAgent labels. It never contains browser credentials.
GATEWAY_LOGIN_CONTROL_URL=http://host.docker.internal:8340
GATEWAY_LOGIN_CONTROL_SECRET_FILE=/run/secrets/turtle_login_control_secret
TURTLE_LOGIN_CONTROL_HOST=127.0.0.1
TURTLE_LOGIN_CONTROL_PORT=8340
TURTLE_LOGIN_RUNTIME_MANIFEST=.runtime/account-runtimes.json
TURTLE_LOGIN_CONTROL_SECRET_FILE=.runtime/secrets/turtle_login_control_secret

# Strict media isolation. The application/Gateway/gpt4free hosts never read or
# upload attachment bodies. Deploy the pump on a separate high-bandwidth host
# and use the same random secret there as MEDIA_PUMP_SHARED_SECRET.
TURTLE_MEDIA_STRICT=true
TURTLE_MEDIA_PUMP_URL=https://media-pump.example.com
TURTLE_MEDIA_PUMP_SECRET=replace-with-a-distinct-long-random-media-pump-secret
TURTLE_MEDIA_PUMP_TIMEOUT_SECONDS=1800
TURTLE_MEDIA_PUMP_MAX_INPUT_BYTES=209715200
# Opaque authenticated ChatGPT media relay URLs expire quickly and carry only
# AES-GCM ciphertext. The Worker enforces an upper bound of 900 seconds.
TURTLE_MEDIA_AUTH_TTL_SECONDS=600

# Public model -> gpt4free OpenaiAccount mapping.
PUBLIC_MODEL_NAME=gpt-5-web
UPSTREAM_MODEL=auto

# upstream | mock. Never treat mock results as ChatGPT validation.
GATEWAY_BACKEND=upstream
GATEWAY_CLAUDE_POOL_ENABLED=true
UPSTREAM_BASE_URL=http://127.0.0.1:8320/v1
UPSTREAM_HEALTH_PATH=/api/OpenaiAccount/quota
UPSTREAM_TIMEOUT_SECONDS=900
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8000

# Compose-only host routing. These defaults preserve the local workstation
# layout. A remote deployment may point the containers at separately managed
# loopback workers and may publish Open WebUI only on the reverse-proxy bridge
# address; internal workers and Gateway must never bind a public interface.
COMPOSE_GPT_UPSTREAM_BASE_URL=http://host.docker.internal:8320/v1
COMPOSE_CLAUDE_UPSTREAM_BASE_URL=http://host.docker.internal:8330/v1
COMPOSE_LOGIN_CONTROL_URL=http://host.docker.internal:8340
COMPOSE_OPENAI_API_BASE_URLS=http://gateway:8000/v1
COMPOSE_GPT_IMAGES_BASE_URL=http://host.docker.internal:8320/v1
GATEWAY_PUBLISH_IP=127.0.0.1
GATEWAY_PUBLISH_PORT=8000
WEBUI_PUBLISH_IP=127.0.0.1
WEBUI_PUBLISH_PORT=3000
TURTLE_DOCKER_SUBNET=172.30.23.0/24
GATEWAY_IMAGE=turtle-gpt-gateway:0.1.0
GATEWAY_RUNTIME_USER=65532:65532
OPEN_WEBUI_IMAGE=turtle-gpt-open-webui:0.5.0

# Host-side pinned gpt4free process. UPSTREAM_API_KEY protects its local API;
# the captured ChatGPT authentication remains only in the ignored auth dir.
GPT4FREE_BIND_HOST=127.0.0.1
GPT4FREE_PORT=8320
GPT4FREE_PROVIDER=OpenaiAccount
GPT4FREE_MODEL=auto
GPT4FREE_AUTH_DIR=.runtime/gpt4free-auth

# A dedicated Chrome is needed only for first login and later reauthentication.
# CDP must stay loopback-only and is normally stopped after auth succeeds.
GPT4FREE_BROWSER_HOST=127.0.0.1
GPT4FREE_BROWSER_PORT=9223

# Claude uses a completely separate host process, browser profile and auth
# directory. The worker reuses GATEWAY_API_KEY only for Open WebUI -> worker
# authentication; Claude browser cookies never enter Compose or PostgreSQL.
# No Claude model is published until turtle-claude-verify records a real route.
CLAUDE_BIND_HOST=127.0.0.1
CLAUDE_PORT=8330
CLAUDE_PUBLIC_MODEL_NAME=claude-web
CLAUDE_BASE_URL=https://claude.ai
CLAUDE_AUTH_PATH=.runtime/claude-auth/session.json
CLAUDE_VERIFIED_MODELS_PATH=.runtime/claude-auth/verified-models.json
CLAUDE_TIMEOUT_SECONDS=900
CLAUDE_LOCALE=en-US
CLAUDE_BROWSER_PORT=9225
# Optional explicit egress proxy. The local Codex runtime can use its adaptive
# relay (`http://127.0.0.1:17897`); production must supply its own approved
# regional egress instead of copying a developer-machine address.
# CLAUDE_PROXY_URL=

# Pinned Open WebUI base for the Turtle's Chat derivative image. Review the
# branding patch and run visual QA before changing this digest.
OPEN_WEBUI_BASE_IMAGE=ghcr.io/open-webui/open-webui@sha256:72c0ba641ba75e7aa52655cb242570906ececd09b1140fb736483038a22b3228
